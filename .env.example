# Server Configuration
SERVER_PORT=8080

# Valkey Configuration (Storage)
VALKEY_URL=redis://localhost:6379
VALKEY_PASSWORD=your_valkey_password_here

# LLM Configuration
LLM_PROVIDER=google
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.0-flash-exp

# Keycloak Configuration
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/master/protocol/openid-connect/certs

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# Frontend Configuration
VITE_ENABLE_AUTH=false
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=mcp
VITE_KEYCLOAK_CLIENT_ID=mcp-orchestrator-ui
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws
